# Copy to .env and fill secrets. Never commit .env.

# App
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_PUBLIC_BASE_URL=http://localhost:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Database
POSTGRES_USER=ganjeh
POSTGRES_PASSWORD=ganjeh_secret
POSTGRES_DB=ganjeh
DATABASE_URL=postgresql+asyncpg://ganjeh:ganjeh_secret@db:5432/ganjeh

# Sepidar MCP (same gateway as Cursor MCP; server-side, no Cursor dependency)
# Token: از تنظیمات MCP Cursor / مدیر سیستم بگیرید و اینجا بگذارید
SEPIDAR_MCP_URL=http://62.60.162.156:8787/mcp
SEPIDAR_MCP_TOKEN=

# maahed.ir admin panel (captcha solved automatically via Playwright OCR)
MAAHED_SITE_BASE_URL=https://maahed.ir
MAAHED_SITE_ADMIN_LOGIN_PATH=/admin-panel/login
MAAHED_SITE_USERNAME=
MAAHED_SITE_PASSWORD=
# Local Windows: chrome | Docker image: leave empty (bundled Chromium)
PLAYWRIGHT_CHANNEL=chrome

# Bots — leave empty to use StubBot
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
# Optional API bases
# BALE_API_BASE_URL=https://tapi.bale.ai
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# Owner Bale chat_id for notify + default inbound allowlist
BOT_NOTIFY_RECIPIENT=1566616156
# Optional extra allowlist (comma-separated); empty → BOT_NOTIFY_RECIPIENT
# BALE_INGEST_CHAT_IDS=1566616156
# auto | webhook | poll | off — auto uses webhook when APP_PUBLIC_BASE_URL is public https
# BALE_INGEST_MODE=auto
# Optional webhook secret (header X-Telegram-Bot-Api-Secret-Token)
# BALE_WEBHOOK_SECRET=

# Local uploads (Windows/dev); Docker uses /app/uploads; Darkube: /data/uploads
UPLOAD_DIR=./uploads
